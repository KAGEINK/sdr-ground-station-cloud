# Copy to ".env" on the station PC and fill in. NEVER commit .env to GitHub.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (service_role / sb_secret_...) - station PC only!
SUPABASE_SERVICE_KEY=YOUR-SECRET-KEY
# Folder where SatDump writes one sub-folder per pass
SATDUMP_OUTPUT_DIR=C:\Users\YOU\Documents\SatDump\live_output
STATION_NAME=Jazan University Ground Station
