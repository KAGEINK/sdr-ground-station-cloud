# Copy to ".streamlit/secrets.toml" for local runs (never commit it),
# and paste the same two lines into Streamlit Cloud -> App -> Settings -> Secrets.
SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
# Public key only (anon / sb_publishable_...). Never the secret key here.
SUPABASE_KEY = "YOUR-PUBLIC-KEY"
